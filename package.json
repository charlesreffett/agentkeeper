{
  "name": "agent-keeper",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter desktop dev",
    "build": "pnpm -r --filter './packages/*' build && pnpm --filter desktop build",
    "typecheck": "pnpm -r typecheck",
    "dist:mac": "pnpm build && pnpm --filter desktop dist:mac",
    "dist:win": "pnpm build && pnpm --filter desktop dist:win",
    "postinstall": "node -e \"const {execSync}=require('child_process');try{execSync('find node_modules/.pnpm -name spawn-helper -path \\\"*/node-pty/*\\\" -exec chmod +x {} \\\\;')}catch(e){}\""
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
