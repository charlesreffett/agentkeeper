{
  "name": "@agentkeeper/cli",
  "version": "0.1.0",
  "description": "CLI toolchain for AgentKeeper plugin authors",
  "type": "module",
  "bin": {
    "akp": "./dist/cli.cjs"
  },
  "main": "./dist/cli.cjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm typecheck && esbuild src/cli.ts --bundle --format=cjs --platform=node --target=node24 --outfile=dist/cli.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentkeeper/sdk": "workspace:*",
    "adm-zip": "^0.5.17",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.7",
    "typescript": "^5.6.3"
  }
}
