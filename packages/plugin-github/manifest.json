{
  "schema_version": 1,
  "id": "agentkeeper-github",
  "name": "GitHub",
  "version": "0.1.0",
  "entry": "dist/index.js",
  "description": "GitHub work items via the gh CLI",
  "author": "AgentKeeper",
  "license": "MIT",
  "activation_events": ["onStartup"],
  "permissions": ["workItems", "secrets", "sidebar", "background", "network"],
  "network": {
    "hosts": ["api.github.com", "*.github.com"]
  },
  "settings_schema": {
    "type": "object",
    "properties": {
      "repo": {
        "type": "string",
        "title": "Repository",
        "description": "GitHub repository in owner/repo format",
        "placeholder": "owner/repo"
      }
    }
  }
}
