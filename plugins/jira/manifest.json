{
  "schema_version": 1,
  "id": "jira",
  "name": "Jira",
  "version": "0.3.0",
  "entry": "dist/index.js",
  "description": "Jira work items via the Atlassian REST API",
  "author": "AgentKeeper",
  "license": "MIT",
  "update_url": "https://github.com/agentkeeper-ai/agentkeeper/releases/download/plugin-jira-feed/jira-update-manifest.json",
  "activation_events": [
    "onStartup"
  ],
  "permissions": [
    "workItems",
    "secrets",
    "commands",
    "ui",
    "background",
    "projects",
    "network"
  ],
  "network": {
    "hosts": [
      "https://*.atlassian.net"
    ]
  },
  "renderer": {
    "entry": "dist/renderer.js",
    "views": [
      "jira-board",
      "jira-work-item",
      "jira-settings"
    ]
  },
  "contributes": {
    "navigation": [
      {
        "id": "jira",
        "label": "Jira",
        "icon": "Layers",
        "route": "board",
        "order": 10
      }
    ],
    "settings": [
      {
        "id": "jira-settings",
        "label": "Jira",
        "icon": "Layers",
        "route": "settings",
        "group": "Integrations"
      }
    ],
    "routes": [
      {
        "id": "board",
        "path": "board",
        "view": "jira-board"
      },
      {
        "id": "work-items",
        "path": "work-items",
        "view": "jira-work-item"
      },
      {
        "id": "settings",
        "path": "settings",
        "view": "jira-settings"
      }
    ]
  },
  "settings_schema": {
    "type": "object",
    "properties": {
      "projectKey": {
        "type": "string",
        "title": "Project Key",
        "description": "Default Jira project key (e.g. MYPROJ)"
      },
      "email": {
        "type": "string",
        "title": "Account email",
        "description": "Email address associated with the Atlassian API token"
      },
      "instanceUrl": {
        "type": "string",
        "title": "Jira site URL",
        "description": "For example https://your-company.atlassian.net"
      }
    }
  }
}
