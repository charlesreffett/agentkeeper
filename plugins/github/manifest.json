{
  "schema_version": 1,
  "id": "github",
  "name": "GitHub",
  "version": "0.1.0",
  "entry": "dist/index.js",
  "description": "GitHub work items via the gh CLI",
  "author": "AgentKeeper",
  "license": "MIT",
  "update_url": "https://github.com/agentkeeper-ai/agentkeeper/releases/download/plugin-github-feed/github-update-manifest.json",
  "activation_events": ["onStartup"],
  "permissions": ["workItems", "secrets", "commands", "ui", "background", "network", "projects"],
  "renderer": {
    "entry": "dist/renderer.js",
    "views": ["github-pulls", "github-work-item"]
  },
  "contributes": {
    "navigation": [
      { "id": "github", "label": "GitHub", "icon": "GitPullRequest", "route": "pulls", "order": 20 }
    ],
    "routes": [
      { "id": "pulls", "path": "pulls", "view": "github-pulls" },
      { "id": "work-items", "path": "work-items", "view": "github-work-item" }
    ]
  },
  "network": {
    "hosts": ["api.github.com", "*.github.com"]
  }
}
